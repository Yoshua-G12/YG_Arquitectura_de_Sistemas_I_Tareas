{
  "name": "yg-arquitectura-sistemas-tareas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run build:shared && turbo run dev --parallel",
    "dev:web": "npm run build:shared && turbo run dev --filter=@repo/web",
    "dev:api": "npm run build:shared && turbo run dev --filter=@repo/api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@repo/web...",
    "build:api": "turbo run build --filter=@repo/api...",
    "build:shared": "turbo run build --filter=@repo/shared",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=@repo/web",
    "test:api": "turbo run test --filter=@repo/api",
    "test:shared": "turbo run test --filter=@repo/shared",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.8.0"
  }
}
